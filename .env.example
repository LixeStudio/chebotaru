# Chebotaru CMS Public API, requested by the Nuxt server only (pictures, articles, sitemap, newsletter sign-up).
# The CMS should set TRUST_PROXY to this server's address so its per-IP sign-up limit counts visitors.
NUXT_CMS_API_BASE=http://127.0.0.1:3000
# Address the browser loads CMS images from (the CMS API or a CDN in front of it)
NUXT_PUBLIC_CMS_MEDIA_BASE=http://127.0.0.1:3000
# Secret of the CMS "content changed" call (POST /api/cms-revalidate); the same value as SITE_REVALIDATE_SECRET in the CMS.
# Empty = the site waits for the 15-30 s cache lifetime instead.
NUXT_CMS_REVALIDATE_SECRET=
# Google Analytics 4 measurement ID (Admin → Data streams → Web → Measurement ID), e.g. G-XXXXXXXXXX.
# Empty = analytics stays off. The script loads only after the first interaction or ~3.5 s (see plugins/gtag.client.ts).
NUXT_PUBLIC_GTAG_ID=
