# Chebotaru CMS Public API, requested by the Nuxt server only (pictures, articles, sitemap)
NUXT_CMS_API_BASE=http://127.0.0.1:3000
# Address the browser loads CMS images from (the CMS API or a CDN in front of it)
NUXT_PUBLIC_CMS_MEDIA_BASE=http://127.0.0.1:3000
# Strapi: newsletter form only, until the CMS has a public subscribe endpoint
NUXT_PUBLIC_STRAPI_URL=
